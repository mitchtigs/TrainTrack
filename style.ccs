body {

font-family: Arial, sans-serif;
background:#f4f4f4;

}


.container {

width:95%;
margin:auto;

}


h2 {

background:#b8d7a8;
padding:10px;

}


.header {

display:flex;
gap:25px;
background:#c5d9f1;
padding:15px;

}


input {

padding:5px;

}


table {

width:100%;
border-collapse:collapse;
background:white;

}


th {

background:#d9eaf7;
border:1px solid black;
font-size:12px;

}


td {

border:1px solid black;
padding:4px;

}


td input {

width:95%;

}


button {

margin-top:15px;
padding:10px 20px;
background:#4CAF50;
color:white;
border:none;

}
